{
  "name": "pokegrid",
  "version": "1.5.33",
  "description": "Rode 4 contas de Poke Idle World ao mesmo tempo, em uma janela so / Run 4 Poke Idle World accounts at once, in a single window",
  "main": "main.js",
  "author": "Asylum",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "test": "node test/iv-math.test.js && node test/boot.test.js && node test/unstuck.test.js && node test/teleport.test.js && node test/sale-recovery.test.js && node test/purchase-recovery.test.js && node test/updater.test.js && node test/release-updater.test.js"
  },
  "keywords": [
    "electron",
    "multi-account",
    "poke-idle-world",
    "idle-game"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.asylum.pokegrid",
    "productName": "PokeGrid",
    "forceCodeSigning": true,
    "asar": true,
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json",
      "tray.png",
      "assets/**/*",
      "presets/**/*",
      "src/**/*",
      "*.md",
      "*.txt",
      "*.bat",
      "*.vbs",
      "*.sh"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/darkgrid-pokeball.ico",
      "artifactName": "PokeGrid-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "PokeGrid-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "PokeGrid-${version}-portable-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "edilsonbim",
      "repo": "PokeGrid-source-fork",
      "releaseType": "release"
    }
  }
}
